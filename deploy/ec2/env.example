# Copy to /etc/trial-booking/env on the EC2 instance (bootstrap.sh creates this automatically).
# File should be owned by root:trial-booking with mode 640.

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Use an absolute path so SQLite survives deploys and release swaps.
DATABASE_URL=file:/var/lib/trial-booking/production.db

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
